# Select the exact chip with: idf.py set-target esp32 / esp32s3 / esp32c3 / ...
CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"
CONFIG_PARTITION_TABLE_FILENAME="partitions.csv"
CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192
CONFIG_FATFS_LFN_HEAP=y
CONFIG_FATFS_MAX_LFN=128
CONFIG_HTTPD_MAX_REQ_HDR_LEN=1024
CONFIG_HTTPD_MAX_URI_LEN=256
CONFIG_COMPILER_CXX_EXCEPTIONS=n
CONFIG_COMPILER_CXX_RTTI=n

# Keep the mbedTLS PKCS#5, Base64 and SHA-256 modules enabled for the
# PBKDF2-HMAC-SHA256 password verifier on the selected ESP-IDF 6.1.x patch.
CONFIG_ESP_CONSOLE_UART_DEFAULT=y
